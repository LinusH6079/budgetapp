generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum ExpenseType {
  RECURRING
  ONE_TIME
}

enum ExpenseOrigin {
  STANDARD
  ANNUAL_SAVING
  LOAN_PAYMENT
  LOAN_EXTRA_PAYMENT
  FINANCING_CASH
}

enum LoanAmortizationType {
  ANNUITY
  STRAIGHT
}

enum FinancingDecision {
  UNDECIDED
  LOAN
  CASH
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum AnnualBudgetRecurrence {
  ONE_TIME
  YEARLY
}

enum AnnualSavingMode {
  TARGET_BY_DATE
  CUSTOM_SCHEDULE
}

enum PlanningType {
  PLANNED
  UNPLANNED
}

enum PayerType {
  FIRST_PERSON
  SECOND_PERSON
  SHARED
}

enum AnnualSavingEntryType {
  CONTRIBUTION
  WITHDRAWAL
}

model User {
  id                           String                   @id @default(cuid())
  name                         String
  email                        String                   @unique
  passwordHash                 String
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  householdMember              HouseholdMember?
  createdInvites               HouseholdInvite[]        @relation("InviteCreator")
  updatedMonths                BudgetMonth[]            @relation("MonthUpdatedBy")
  personSnapshots              MonthlyPersonSnapshot[]  @relation("SnapshotOwner")
  updatedSnapshots             MonthlyPersonSnapshot[]  @relation("SnapshotUpdatedBy")
  updatedExpenses              Expense[]                @relation("ExpenseUpdatedBy")
  updatedSpendingPaceSettings  SpendingPaceSettings[]   @relation("SpendingPaceSettingsUpdatedBy")
  updatedSpendingPaceEntries   SpendingPaceEntry[]      @relation("SpendingPaceEntryUpdatedBy")
  updatedAnnualBudgetItems     AnnualBudgetItem[]       @relation("AnnualBudgetItemUpdatedBy")
  updatedAnnualSavingEntries   AnnualSavingEntry[]      @relation("AnnualSavingEntryUpdatedBy")
  createdAnnualSavingOverrides AnnualSavingOverride[]   @relation("AnnualSavingOverrideCreatedBy")
  updatedAnnualSavingRates     AnnualSavingRate[]       @relation("AnnualSavingRateUpdatedBy")
  updatedFinancingCases        FinancingCase[]          @relation("FinancingCaseUpdatedBy")
  updatedLoans                 Loan[]                   @relation("LoanUpdatedBy")
  updatedLoanRatePeriods       LoanRatePeriod[]         @relation("LoanRatePeriodUpdatedBy")
  updatedLoanExtraPayments     LoanExtraPayment[]       @relation("LoanExtraPaymentUpdatedBy")
  updatedBudgetScenarios       BudgetScenario[]         @relation("BudgetScenarioUpdatedBy")
  scenarioPersonSnapshots      ScenarioPersonSnapshot[] @relation("ScenarioSnapshotOwner")
  updatedScenarioSnapshots     ScenarioPersonSnapshot[] @relation("ScenarioSnapshotUpdatedBy")
  updatedScenarioExpenses      ScenarioExpense[]        @relation("ScenarioExpenseUpdatedBy")
}

model Household {
  id                   String                @id @default(cuid())
  name                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              HouseholdMember[]
  invites              HouseholdInvite[]
  budgetRows           BudgetMonth[]
  spendingPaceSettings SpendingPaceSettings?
  spendingPaceEntries  SpendingPaceEntry[]
  annualBudgetItems    AnnualBudgetItem[]
  financingCases       FinancingCase[]
  loans                Loan[]
  budgetScenarios      BudgetScenario[]
}

model BudgetScenario {
  id                String                   @id @default(cuid())
  householdId       String
  name              String
  referenceMonthKey String
  sourceMonthKey    String?
  note              String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  updatedByUserId   String?
  household         Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser     User?                    @relation("BudgetScenarioUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  personSnapshots   ScenarioPersonSnapshot[]
  expenses          ScenarioExpense[]

  @@index([householdId, updatedAt])
}

model ScenarioPersonSnapshot {
  id               String         @id @default(cuid())
  budgetScenarioId String
  userId           String
  incomeAmount     Int            @default(0)
  carryOverAmount  Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  updatedByUserId  String?
  budgetScenario   BudgetScenario @relation(fields: [budgetScenarioId], references: [id], onDelete: Cascade)
  user             User           @relation("ScenarioSnapshotOwner", fields: [userId], references: [id], onDelete: Cascade)
  updatedByUser    User?          @relation("ScenarioSnapshotUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([budgetScenarioId, userId])
  @@index([budgetScenarioId])
}

model ScenarioExpense {
  id                String         @id @default(cuid())
  budgetScenarioId  String
  sourceExpenseId   String?
  name              String
  amount            Int
  category          String
  expenseType       ExpenseType
  sourceOrigin      ExpenseOrigin  @default(STANDARD)
  planningType      PlanningType   @default(PLANNED)
  payerType         PayerType
  firstPersonSharePercent Int?
  dueDate           DateTime?
  isSystemGenerated Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  updatedByUserId   String?
  budgetScenario    BudgetScenario @relation(fields: [budgetScenarioId], references: [id], onDelete: Cascade)
  updatedByUser     User?          @relation("ScenarioExpenseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([budgetScenarioId, category])
}

model FinancingCase {
  id                String               @id @default(cuid())
  householdId       String
  name              String
  purchasePrice     Int
  downPayment       Int                  @default(0)
  annualInterestBps Int
  termMonths        Int
  setupFee          Int                  @default(0)
  monthlyFee        Int                  @default(0)
  amortizationType  LoanAmortizationType
  startMonth        String
  payerType         PayerType
  decision          FinancingDecision    @default(UNDECIDED)
  isArchived        Boolean              @default(false)
  cashExpenseId     String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  updatedByUserId   String?
  household         Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  cashExpense       Expense?             @relation("FinancingCashExpense", fields: [cashExpenseId], references: [id], onDelete: SetNull)
  loan              Loan?
  updatedByUser     User?                @relation("FinancingCaseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, decision, isArchived])
}

model Loan {
  id               String               @id @default(cuid())
  householdId      String
  financingCaseId  String?              @unique
  name             String
  initialPrincipal Int
  termMonths       Int
  setupFee         Int                  @default(0)
  monthlyFee       Int                  @default(0)
  amortizationType LoanAmortizationType
  startMonth       String
  payerType        PayerType
  status           LoanStatus           @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  updatedByUserId  String?
  household        Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  financingCase    FinancingCase?       @relation(fields: [financingCaseId], references: [id], onDelete: SetNull)
  updatedByUser    User?                @relation("LoanUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  ratePeriods      LoanRatePeriod[]
  installments     LoanInstallment[]
  extraPayments    LoanExtraPayment[]

  @@index([householdId, status])
}

model LoanRatePeriod {
  id                String   @id @default(cuid())
  loanId            String
  startMonth        String
  annualInterestBps Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedByUserId   String?
  loan              Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  updatedByUser     User?    @relation("LoanRatePeriodUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([loanId, startMonth])
  @@index([loanId, startMonth])
}

model LoanInstallment {
  id               String   @id @default(cuid())
  loanId           String
  sequence         Int
  monthKey         String
  openingPrincipal Int
  principalAmount  Int
  interestAmount   Int
  feeAmount        Int
  totalAmount      Int
  expenseId        String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  expense          Expense? @relation("LoanInstallmentExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([loanId, sequence])
  @@index([loanId, monthKey])
}

model LoanExtraPayment {
  id              String   @id @default(cuid())
  loanId          String
  monthKey        String
  amount          Int
  expenseId       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  expense         Expense? @relation("LoanExtraPaymentExpense", fields: [expenseId], references: [id], onDelete: SetNull)
  updatedByUser   User?    @relation("LoanExtraPaymentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([loanId, monthKey])
}

model AnnualBudgetItem {
  id               String                 @id @default(cuid())
  householdId      String
  name             String
  targetAmount     Int
  savingStartMonth String?
  dueMonth         String
  category         String?
  recurrence       AnnualBudgetRecurrence @default(ONE_TIME)
  savingMode       AnnualSavingMode       @default(TARGET_BY_DATE)
  firstPersonSharePercent Int              @default(50)
  isArchived       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  updatedByUserId  String?
  household        Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser    User?                  @relation("AnnualBudgetItemUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  entries          AnnualSavingEntry[]
  linkedExpenses   Expense[]
  savingOverrides  AnnualSavingOverride[]
  savingSchedules  AnnualSavingSchedule[]
  savingRates      AnnualSavingRate[]

  @@index([householdId, isArchived, dueMonth])
}

model AnnualSavingRate {
  id                 String           @id @default(cuid())
  annualBudgetItemId String
  startMonth         String
  endMonth           String?
  monthlyAmount      Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  updatedByUserId    String?
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  updatedByUser      User?            @relation("AnnualSavingRateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([annualBudgetItemId, startMonth])
  @@index([annualBudgetItemId, startMonth])
}

model AnnualSavingOverride {
  id                 String           @id @default(cuid())
  budgetMonthId      String
  annualBudgetItemId String
  createdAt          DateTime         @default(now())
  createdByUserId    String
  budgetMonth        BudgetMonth      @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  createdByUser      User             @relation("AnnualSavingOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, annualBudgetItemId])
  @@index([annualBudgetItemId])
}

model AnnualSavingSchedule {
  id                 String           @id @default(cuid())
  budgetMonthId      String
  annualBudgetItemId String
  expenseId          String           @unique
  budgetMonth        BudgetMonth      @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  expense            Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, annualBudgetItemId])
  @@index([annualBudgetItemId])
}

model AnnualSavingEntry {
  id                 String                @id @default(cuid())
  annualBudgetItemId String
  amount             Int
  entryType          AnnualSavingEntryType @default(CONTRIBUTION)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  updatedByUserId    String?
  sourceExpenseId    String?
  annualBudgetItem   AnnualBudgetItem      @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  updatedByUser      User?                 @relation("AnnualSavingEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  sourceExpense      Expense?              @relation("ExpenseAnnualSavingEntry", fields: [sourceExpenseId], references: [id], onDelete: Cascade)

  @@index([annualBudgetItemId, createdAt])
  @@index([sourceExpenseId])
}

model SpendingPaceSettings {
  id              String    @id @default(cuid())
  householdId     String    @unique
  monthlyLimit    Int
  weeklyLimit     Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("SpendingPaceSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model SpendingPaceEntry {
  id              String    @id @default(cuid())
  householdId     String
  cycleStartKey   String
  weekStartKey    String
  amount          Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("SpendingPaceEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, cycleStartKey, weekStartKey])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String        @unique
  role        HouseholdRole
  joinedAt    DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  code            String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  createdByUserId String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([householdId, expiresAt])
}

model BudgetMonth {
  id                    String                  @id @default(cuid())
  householdId           String
  monthKey              String
  note                  String?
  isLocked              Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  updatedByUserId       String?
  household             Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser         User?                   @relation("MonthUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  personSnapshots       MonthlyPersonSnapshot[]
  expenses              Expense[]
  annualSavingOverrides AnnualSavingOverride[]
  annualSavingSchedules AnnualSavingSchedule[]

  @@unique([householdId, monthKey])
  @@index([householdId, monthKey])
}

model MonthlyPersonSnapshot {
  id              String      @id @default(cuid())
  budgetMonthId   String
  userId          String
  incomeAmount    Int         @default(0)
  carryOverAmount Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  updatedByUserId String?
  budgetMonth     BudgetMonth @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  user            User        @relation("SnapshotOwner", fields: [userId], references: [id], onDelete: Cascade)
  updatedByUser   User?       @relation("SnapshotUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([budgetMonthId, userId])
  @@index([budgetMonthId])
}

model Expense {
  id                       String                @id @default(cuid())
  budgetMonthId            String
  recurringSourceExpenseId String?
  swishId                  String?
  name                     String
  amount                   Int
  category                 String
  expenseType              ExpenseType
  origin                   ExpenseOrigin         @default(STANDARD)
  planningType             PlanningType          @default(PLANNED)
  payerType                PayerType
  firstPersonSharePercent  Int?
  dueDate                  DateTime?
  isPaid                   Boolean               @default(false)
  paidAt                   DateTime?
  firstPersonPaidAt        DateTime?
  secondPersonPaidAt       DateTime?
  firstPersonSwishId       String?
  secondPersonSwishId      String?
  note                     String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  updatedByUserId          String?
  annualBudgetItemId       String?
  budgetMonth              BudgetMonth           @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  updatedByUser            User?                 @relation("ExpenseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  annualBudgetItem         AnnualBudgetItem?     @relation(fields: [annualBudgetItemId], references: [id], onDelete: SetNull)
  annualSavingEntries      AnnualSavingEntry[]   @relation("ExpenseAnnualSavingEntry")
  annualSavingSchedule     AnnualSavingSchedule?
  financingCashCase        FinancingCase?        @relation("FinancingCashExpense")
  loanInstallment          LoanInstallment?      @relation("LoanInstallmentExpense")
  loanExtraPayment         LoanExtraPayment?     @relation("LoanExtraPaymentExpense")

  @@unique([budgetMonthId, recurringSourceExpenseId])
  @@index([budgetMonthId, dueDate])
  @@index([budgetMonthId, category])
  @@index([budgetMonthId, swishId])
  @@index([recurringSourceExpenseId])
  @@index([swishId])
  @@index([firstPersonSwishId])
  @@index([secondPersonSwishId])
  @@index([annualBudgetItemId])
}
