generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum ExpenseType {
  RECURRING
  ONE_TIME
}

enum ExpenseOrigin {
  STANDARD
  ANNUAL_SAVING
}

enum AnnualBudgetRecurrence {
  ONE_TIME
  YEARLY
}

enum AnnualSavingMode {
  TARGET_BY_DATE
  CUSTOM_SCHEDULE
}

enum PlanningType {
  PLANNED
  UNPLANNED
}

enum PayerType {
  FIRST_PERSON
  SECOND_PERSON
  SHARED
}

enum AnnualSavingEntryType {
  CONTRIBUTION
  WITHDRAWAL
}

model User {
  id                           String                  @id @default(cuid())
  name                         String
  email                        String                  @unique
  passwordHash                 String
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  householdMember              HouseholdMember?
  createdInvites               HouseholdInvite[]       @relation("InviteCreator")
  updatedMonths                BudgetMonth[]           @relation("MonthUpdatedBy")
  personSnapshots              MonthlyPersonSnapshot[] @relation("SnapshotOwner")
  updatedSnapshots             MonthlyPersonSnapshot[] @relation("SnapshotUpdatedBy")
  updatedExpenses              Expense[]               @relation("ExpenseUpdatedBy")
  updatedSpendingPaceSettings  SpendingPaceSettings[]  @relation("SpendingPaceSettingsUpdatedBy")
  updatedSpendingPaceEntries   SpendingPaceEntry[]     @relation("SpendingPaceEntryUpdatedBy")
  updatedAnnualBudgetItems     AnnualBudgetItem[]      @relation("AnnualBudgetItemUpdatedBy")
  updatedAnnualSavingEntries   AnnualSavingEntry[]     @relation("AnnualSavingEntryUpdatedBy")
  createdAnnualSavingOverrides AnnualSavingOverride[]  @relation("AnnualSavingOverrideCreatedBy")
  updatedAnnualSavingRates     AnnualSavingRate[]      @relation("AnnualSavingRateUpdatedBy")
}

model Household {
  id                   String                @id @default(cuid())
  name                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              HouseholdMember[]
  invites              HouseholdInvite[]
  budgetRows           BudgetMonth[]
  spendingPaceSettings SpendingPaceSettings?
  spendingPaceEntries  SpendingPaceEntry[]
  annualBudgetItems    AnnualBudgetItem[]
}

model AnnualBudgetItem {
  id              String                 @id @default(cuid())
  householdId     String
  name            String
  targetAmount    Int
  dueMonth        String
  category        String?
  recurrence      AnnualBudgetRecurrence @default(ONE_TIME)
  savingMode      AnnualSavingMode       @default(TARGET_BY_DATE)
  isArchived      Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  updatedByUserId String?
  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser   User?                  @relation("AnnualBudgetItemUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  entries         AnnualSavingEntry[]
  linkedExpenses  Expense[]
  savingOverrides AnnualSavingOverride[]
  savingSchedules AnnualSavingSchedule[]
  savingRates     AnnualSavingRate[]

  @@index([householdId, isArchived, dueMonth])
}

model AnnualSavingRate {
  id                 String           @id @default(cuid())
  annualBudgetItemId String
  startMonth         String
  endMonth           String?
  monthlyAmount      Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  updatedByUserId    String?
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  updatedByUser      User?            @relation("AnnualSavingRateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([annualBudgetItemId, startMonth])
  @@index([annualBudgetItemId, startMonth])
}

model AnnualSavingOverride {
  id                 String           @id @default(cuid())
  budgetMonthId      String
  annualBudgetItemId String
  createdAt          DateTime         @default(now())
  createdByUserId    String
  budgetMonth        BudgetMonth      @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  createdByUser      User             @relation("AnnualSavingOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, annualBudgetItemId])
  @@index([annualBudgetItemId])
}

model AnnualSavingSchedule {
  id                 String           @id @default(cuid())
  budgetMonthId      String
  annualBudgetItemId String
  expenseId          String           @unique
  budgetMonth        BudgetMonth      @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  annualBudgetItem   AnnualBudgetItem @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  expense            Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, annualBudgetItemId])
  @@index([annualBudgetItemId])
}

model AnnualSavingEntry {
  id                 String                @id @default(cuid())
  annualBudgetItemId String
  amount             Int
  entryType          AnnualSavingEntryType @default(CONTRIBUTION)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  updatedByUserId    String?
  sourceExpenseId    String?
  annualBudgetItem   AnnualBudgetItem      @relation(fields: [annualBudgetItemId], references: [id], onDelete: Cascade)
  updatedByUser      User?                 @relation("AnnualSavingEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  sourceExpense      Expense?              @relation("ExpenseAnnualSavingEntry", fields: [sourceExpenseId], references: [id], onDelete: Cascade)

  @@index([annualBudgetItemId, createdAt])
  @@index([sourceExpenseId])
}

model SpendingPaceSettings {
  id              String    @id @default(cuid())
  householdId     String    @unique
  monthlyLimit    Int
  weeklyLimit     Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("SpendingPaceSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model SpendingPaceEntry {
  id              String    @id @default(cuid())
  householdId     String
  cycleStartKey   String
  weekStartKey    String
  amount          Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("SpendingPaceEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, cycleStartKey, weekStartKey])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String        @unique
  role        HouseholdRole
  joinedAt    DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  code            String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  createdByUserId String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([householdId, expiresAt])
}

model BudgetMonth {
  id                    String                  @id @default(cuid())
  householdId           String
  monthKey              String
  note                  String?
  isLocked              Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  updatedByUserId       String?
  household             Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  updatedByUser         User?                   @relation("MonthUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  personSnapshots       MonthlyPersonSnapshot[]
  expenses              Expense[]
  annualSavingOverrides AnnualSavingOverride[]
  annualSavingSchedules AnnualSavingSchedule[]

  @@unique([householdId, monthKey])
  @@index([householdId, monthKey])
}

model MonthlyPersonSnapshot {
  id              String      @id @default(cuid())
  budgetMonthId   String
  userId          String
  incomeAmount    Int         @default(0)
  carryOverAmount Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  updatedByUserId String?
  budgetMonth     BudgetMonth @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  user            User        @relation("SnapshotOwner", fields: [userId], references: [id], onDelete: Cascade)
  updatedByUser   User?       @relation("SnapshotUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([budgetMonthId, userId])
  @@index([budgetMonthId])
}

model Expense {
  id                       String                @id @default(cuid())
  budgetMonthId            String
  recurringSourceExpenseId String?
  swishId                  String?
  name                     String
  amount                   Int
  category                 String
  expenseType              ExpenseType
  origin                   ExpenseOrigin         @default(STANDARD)
  planningType             PlanningType          @default(PLANNED)
  payerType                PayerType
  dueDate                  DateTime?
  isPaid                   Boolean               @default(false)
  paidAt                   DateTime?
  firstPersonPaidAt        DateTime?
  secondPersonPaidAt       DateTime?
  firstPersonSwishId       String?
  secondPersonSwishId      String?
  note                     String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  updatedByUserId          String?
  annualBudgetItemId       String?
  budgetMonth              BudgetMonth           @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  updatedByUser            User?                 @relation("ExpenseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  annualBudgetItem         AnnualBudgetItem?     @relation(fields: [annualBudgetItemId], references: [id], onDelete: SetNull)
  annualSavingEntries      AnnualSavingEntry[]   @relation("ExpenseAnnualSavingEntry")
  annualSavingSchedule     AnnualSavingSchedule?

  @@unique([budgetMonthId, recurringSourceExpenseId])
  @@index([budgetMonthId, dueDate])
  @@index([budgetMonthId, category])
  @@index([budgetMonthId, swishId])
  @@index([recurringSourceExpenseId])
  @@index([swishId])
  @@index([firstPersonSwishId])
  @@index([secondPersonSwishId])
  @@index([annualBudgetItemId])
}
